# JARVIS
PRODUCT_NAME=JARVIS
DEMO_MODE=0
# Force cinematic kit packs without calling Groq/Ollama (1/true/on)
# JARVIS_DEMO_OFFLINE=1
GRAPH_MODE=mini
DEV_MODE=0
IMAGE_ENABLED=false

# Vault
VAULT_PATH=C:\Users\siddu\OneDrive\Desktop\jarvis-vault
AUTO_SAVE_VAULT=0
AUTO_SYNC_VAULT=1

# Secrets at rest (Fernet). Generate any long random string and keep it stable.
# Without this key, Google tokens remain plaintext in state.json (legacy).
JARVIS_MASTER_KEY=

# Optional API token — when set, mutating routes require Authorization: Bearer …
JARVIS_API_TOKEN=
# Frontend: same token via localStorage key JARVIS_API_TOKEN or:
# NEXT_PUBLIC_JARVIS_API_TOKEN=

# House / Home Assistant
HOUSE_BACKEND=sim
HOUSE_WRITES_ENABLED=0
HA_URL=
HA_TOKEN=
HA_ENTITY_ALLOWLIST=light.lab,light.workshop,light.lounge,switch.fabricator,climate.lab
HA_ALLOW_CRITICAL=0
PROACTIVE_TTS=0
OLLAMA_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_FALLBACK_MODELS=qwen/qwen3.6-27b
GROQ_RESEARCH_MODEL=groq/compound
GROQ_REPORT_MODEL=openai/gpt-oss-120b
LLM_PRIMARY=groq
LLM_MAX_TOKENS=1024
LLM_HISTORY_TURNS=6
# Optional: BRAVE_API_KEY=
# Optional: TAVILY_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
# RAG_SEMANTIC=0
PROACTIVE_TTS=0

# RAG
QDRANT_URL=http://localhost:6335
EMBEDDING_MODEL=all-MiniLM-L6-v2

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=Siddarthb07

# Infrastructure command center
DOCKER_MONITOR_ENABLED=1
INFRA_SITE_POLL_SEC=60
INFRA_DOCKER_POLL_SEC=10
INFRA_PAGES_DISCOVERY_SEC=1800
INFRA_RETENTION_DAYS=30
# Native fallback collector snapshot; Compose overrides this inside backend.
# INFRA_DOCKER_SNAPSHOT_PATH=C:\path\to\AI-BRAIN\backend\data\infra\docker_snapshot.json

# Speech
WHISPER_MODEL=base
TTS_ENGINE=pyttsx3

# Google Calendar (beta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/calendar/google/callback
GOOGLE_FRONTEND_URL=http://127.0.0.1:5055

# Frontend — use same-origin proxy (next.config.js rewrites /backend → FastAPI)
NEXT_PUBLIC_API_URL=/backend
# Set PUBLIC_MODE=1 when sharing via LAN IP or Cloudflare Tunnel
PUBLIC_MODE=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5050,http://127.0.0.1:5050,http://localhost:5055,http://127.0.0.1:5055

GROQ_VISION_MODEL=qwen/qwen3.6-27b
