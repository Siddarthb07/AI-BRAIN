# JARVIS
PRODUCT_NAME=JARVIS
DEMO_MODE=0
GRAPH_MODE=mini
DEV_MODE=0
IMAGE_ENABLED=false

# Vault
VAULT_PATH=C:\Users\siddu\OneDrive\Desktop\jarvis-vault
AUTO_SAVE_VAULT=0
AUTO_SYNC_VAULT=1

# Secrets at rest (Fernet). Generate any long random string and keep it stable.
# Without this key, Google tokens remain plaintext in state.json (legacy).
JARVIS_MASTER_KEY=

# Optional API token â€” when set, mutating routes require Authorization: Bearer â€¦
JARVIS_API_TOKEN=

# House / Home Assistant
HOUSE_BACKEND=sim
HOUSE_WRITES_ENABLED=0
HA_URL=
HA_TOKEN=
HA_ENTITY_ALLOWLIST=light.lab,light.workshop,light.lounge,switch.fabricator,climate.lab
HA_ALLOW_CRITICAL=0
PROACTIVE_TTS=0
OLLAMA_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PRIMARY=groq
LLM_MAX_TOKENS=4096
LLM_HISTORY_TURNS=12
PROACTIVE_TTS=0

# RAG
QDRANT_URL=http://localhost:6335
EMBEDDING_MODEL=all-MiniLM-L6-v2

# GitHub
GITHUB_TOKEN=

# Speech
WHISPER_MODEL=base
TTS_ENGINE=pyttsx3

# Google Calendar (beta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/calendar/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5050

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5050,http://127.0.0.1:5050

GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
